@{
    ViewData["Title"] = "Drone Image Upload";
}

<h2>Drone Image Upload</h2>

<p class="text-muted">
    Upload drone imagery to Azure Blob Storage for automatic processing.
</p>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}

<div asp-validation-summary="All" class="text-danger"></div>

<div class="card shadow-sm p-4">
    <form asp-controller="Upload"
          asp-action="UploadDroneImage"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">
                Select Drone Image
            </label>

            <input type="file"
                   name="file"
                   class="form-control"
                   accept=".jpg,.jpeg,.png"
                   required />
        </div>

        <button type="submit" class="btn btn-success">
            Upload Drone Image
        </button>
    </form>
</div>
