<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AgriStream IoT</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    @await RenderSectionAsync("Scripts", required: false)

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-success mb-4">
            <div class="container">
                <a class="navbar-brand" href="/">AgriStream IoT</a>
                <div class="navbar-nav">
                    <a class="nav-link text-white" href="/Home/Dashboard">Dashboard</a>
                    <a class="nav-link text-white" href="/Upload">Upload Drone Image</a>
                    <a class="nav-link text-white" href="/Irrigation">Trigger Irrigation</a>
                    <a class="nav-link text-white" href="/Account/Login">Login</a>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success">@TempData["Message"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }
            @RenderBody()
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
